# User-generated music, images and other exports (keep the folder itself)
/output/*
!/output/.gitkeep

# Python bytecode, caches, coverage and local test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Python environments and build artifacts
.venv/
venv/
env/
build/
dist/
*.egg-info/
*.egg
*.whl

# Secrets, local machine settings and editor files
.env
.env.*
!.env.example
.vscode/
.idea/
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db
Desktop.ini


# ==========================================
# PyInstaller build artifacts
# ==========================================

/build/
/dist/

# Previous temporary build folders
/build_*/
/dist_*/

# PyInstaller-generated files
*.pyz
*.pkg

# Keep packaging configuration files (.spec)
# Do not ignore *.spec
